<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>New Adoption Application</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/css/bootstrap.min.css">
</head>
<body class="container my-4" style="max-width: 600px;">
    <h1 class="mb-4">Submit Adoption Application</h1>

    <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/adoptions" method="POST">
        <div class="mb-3">
            <label class="form-label">User ID:</label>
            <input type="number" name="user_id" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Animal ID:</label>
            <input type="number" name="animal_id" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Application Date:</label>
            <input type="date" name="application_date" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label">Notes / Reason for Adopting:</label>
            <textarea name="notes" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Submit Application</button>
        <a href="/adoptions" class="btn btn-secondary">Cancel</a>
    </form>
</body>
</html>