<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Process Adoption</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/css/bootstrap.min.css">
</head>
<body class="container my-4" style="max-width: 600px;">
    <h1 class="mb-4">Finalize Adoption & Issue Contract</h1>

    <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Application Details</h5>
            <p><strong>Application ID:</strong> <%= application.application_id %></p>
            <p><strong>Adopter:</strong> <%= application.full_name %> (<%= application.email %>)</p>
            <p><strong>Animal:</strong> <%= application.animal_name %></p>
            <p><strong>Current Status:</strong> <span class="badge bg-info"><%= application.status %></span></p>
        </div>
    </div>

    <form action="/adoptions/<%= application.application_id %>/process" method="POST">
        <div class="mb-3">
            <label class="form-label">Adoption Date:</label>
            <input type="date" name="adoption_date" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label">Adoption Fee (₱):</label>
            <input type="number" step="0.01" name="adoption_fee" class="form-control" value="0.00" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Contract Details / Terms:</label>
            <textarea name="contract_details" class="form-control" rows="4" required>Adoption contract signed and verified. Home check completed successfully.</textarea>
        </div>

        <button type="submit" class="btn btn-success">Finalize & Complete Adoption</button>
        <a href="/adoptions" class="btn btn-secondary">Back to Dashboard</a>
    </form>
</body>
</html>