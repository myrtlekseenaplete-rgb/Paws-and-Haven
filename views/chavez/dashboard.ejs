<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Adoption Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/css/bootstrap.min.css">
</head>
<body class="container my-4">
    <h1 class="mb-4">🐾 Adoption Management Dashboard</h1>
    
    <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="mb-3">
        <a href="/adoptions/new" class="btn btn-primary">+ New Adoption Application</a>
    </div>

    <h2>Adoption Applications</h2>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Adopter Name</th>
                <th>Animal</th>
                <th>Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (applications && applications.length > 0) { %>
                <% applications.forEach(app => { %>
                    <tr>
                        <td><%= app.application_id %></td>
                        <td><%= app.full_name %></td>
                        <td><%= app.animal_name %></td>
                        <td><%= app.application_date ? new Date(app.application_date).toLocaleDateString() : '' %></td>
                        <td>
                            <span class="badge bg-<%= app.status === 'Approved' ? 'success' : (app.status === 'Rejected' ? 'danger' : 'warning') %>">
                                <%= app.status %>
                            </span>
                        </td>
                        <td>
                            <a href="/adoptions/<%= app.application_id %>/process" class="btn btn-sm btn-info">Process / Finalize</a>
                            
                            <!-- Quick Status Update Forms -->
                            <form action="/adoptions/<%= app.application_id %>/status" method="POST" class="d-inline">
                                <input type="hidden" name="status" value="Approved">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form action="/adoptions/<%= app.application_id %>/status" method="POST" class="d-inline">
                                <input type="hidden" name="status" value="Rejected">
                                <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="6" class="text-center">No adoption applications found.</td></tr>
            <% } %>
        </tbody>
    </table>

    <h2 class="mt-5">Completed Adoptions & Contracts</h2>
    <table class="table table-bordered table-striped">
        <thead class="table-secondary">
            <tr>
                <th>Adoption ID</th>
                <th>Adopter</th>
                <th>Animal</th>
                <th>Date</th>
                <th>Fee</th>
                <th>Contract Details</th>
            </tr>
        </thead>
        <tbody>
            <% if (adoptions && adoptions.length > 0) { %>
                <% adoptions.forEach(adop => { %>
                    <tr>
                        <td><%= adop.adoption_id %></td>
                        <td><%= adop.full_name %></td>
                        <td><%= adop.animal_name %></td>
                        <td><%= adop.adoption_date ? new Date(adop.adoption_date).toLocaleDateString() : '' %></td>
                        <td>₱<%= adop.adoption_fee %></td>
                        <td><%= adop.contract_details %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="6" class="text-center">No completed adoptions yet.</td></tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>