<!DOCTYPE html>
<html>
<head>
  <title>Medical Logs - Paws and Haven</title>
</head>
<body>
  <div style="max-width: 800px; margin: 40px auto; font-family: sans-serif;">
    <h2>Animal Medical Records & Logs 🐾</h2>
    <a href="/medical/reports" style="color: #4A90E2; text-decoration: none; font-weight: bold;">View Special SQL Join Reports &rarr;</a>
    
    <hr style="margin: 20px 0;">

    <h3>Add New Medical Record</h3>
    <form action="/medical/create" method="POST" style="background: #f9f9f9; padding: 20px; border-radius: 8px;">
      <div style="margin-bottom: 10px;">
        <label>Animal ID:</label><br>
        <input type="number" name="animal_id" required style="width: 100%; padding: 6px;">
      </div>
      <div style="margin-bottom: 10px;">
        <label>Vet ID:</label><br>
        <input type="number" name="vet_id" style="width: 100%; padding: 6px;">
      </div>
      <div style="margin-bottom: 10px;">
        <label>Diagnosis:</label><br>
        <textarea name="diagnosis" required style="width: 100%; padding: 6px;"></textarea>
      </div>
      <div style="margin-bottom: 10px;">
        <label>Treatment:</label><br>
        <textarea name="treatment" required style="width: 100%; padding: 6px;"></textarea>
      </div>
      <div style="margin-bottom: 10px;">
        <label>Record Date:</label><br>
        <input type="date" name="record_date" required style="width: 100%; padding: 6px;">
      </div>
      <div style="margin-bottom: 10px;">
        <label>Notes:</label><br>
        <textarea name="notes" style="width: 100%; padding: 6px;"></textarea>
      </div>
      <button type="submit" style="padding: 8px 15px; background: #28a745; color: white; border: none; cursor: pointer;">Save Record</button>
    </form>

    <h3 style="margin-top: 40px;">Existing Medical History</h3>
    <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="background: #eee;">
          <th>ID</th>
          <th>Animal ID</th>
          <th>Diagnosis</th>
          <th>Treatment</th>
          <th>Date</th>
          <th>Vet Name</th>
        </tr>
      </thead>
      <tbody>
        <% if (locals.records && records.length > 0) { %>
          <% records.forEach(r => { %>
            <tr>
              <td><%= r.id %></td>
              <td><%= r.animal_id %></td>
              <td><%= r.diagnosis %></td>
              <td><%= r.treatment %></td>
              <td><%= r.record_date %></td>
              <td><%= r.vet_name || 'N/A' %> (<%= r.specialization || 'General' %>)</td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" style="text-align: center;">No medical records found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
