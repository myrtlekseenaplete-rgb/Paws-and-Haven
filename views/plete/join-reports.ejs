<!DOCTYPE html>
<html>
<head>
  <title>SQL Join Reports - Paws and Haven</title>
</head>
<body>
  <div style="max-width: 800px; margin: 40px auto; font-family: sans-serif;">
    <h2>Special SQL Join Reports 📊</h2>
    <a href="/medical" style="color: #4A90E2; text-decoration: none; font-weight: bold;">&larr; Back to Medical Logs</a>

    <h3 style="margin-top: 30px;">1. RIGHT JOIN Report (All Veterinarians & Their Records)</h3>
    <table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
      <tr style="background: #eee;">
        <th>Veterinarian</th>
        <th>Specialization</th>
        <th>Diagnosis</th>
        <th>Treatment</th>
        <th>Date</th>
      </tr>
      <% if (locals.rightJoin && rightJoin.length > 0) { %>
        <% rightJoin.forEach(row => { %>
          <tr>
            <td><%= row.veterinarian_name %></td>
            <td><%= row.specialization %></td>
            <td><%= row.diagnosis || 'No records' %></td>
            <td><%= row.treatment || 'N/A' %></td>
            <td><%= row.record_date || 'N/A' %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="5" style="text-align: center;">No data available.</td></tr>
      <% } %>
    </table>

    <h3>2. FULL OUTER JOIN Simulation (UNION of LEFT & RIGHT Joins)</h3>
    <table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse;">
      <tr style="background: #eee;">
        <th>Record ID</th>
        <th>Diagnosis</th>
        <th>Vet Name</th>
      </tr>
      <% if (locals.fullOuterJoin && fullOuterJoin.length > 0) { %>
        <% fullOuterJoin.forEach(row => { %>
          <tr>
            <td><%= row.record_id || 'N/A' %></td>
            <td><%= row.diagnosis || 'Unmatched / N/A' %></td>
            <td><%= row.vet_name || 'Unmatched / N/A' %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="3" style="text-align: center;">No data available.</td></tr>
      <% } %>
    </table>
  </div>
</body>
</html>
