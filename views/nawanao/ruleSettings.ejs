<!DOCTYPE html>
<html>
<head>
<title>Rule Settings - Paws and Haven</title>
<style>
body { font-family: Arial; background: #f4f6f9; padding: 25px; }
.box { background: white; padding: 20px; border-radius: 10px; }
button { background: #198754; color: white; padding: 10px; border: none; }
</style>
</head>
<body>
<h2>Paws and Haven - Rule Settings</h2>

<div class="box">
<h3>Quarantine Rule</h3>

<form action="/rules/settings" method="POST">
<label>Required Quarantine Days:</label>
<input type="number" name="quarantineDays"
min="1" value="<%= typeof quarantineDays !== 'undefined' ? quarantineDays : 14 %>" required>

<br><br>
<button type="submit">Save Settings</button>
</form>
</div>

<p><a href="/audit">View Audit Logs</a></p>
</body>
</html>
