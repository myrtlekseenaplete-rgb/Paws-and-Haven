<div class="container mt-4">
  <h2>Global System Settings Control Panel</h2>
  <form action="/admin/settings/update" method="POST" class="mt-3 p-3 border rounded">
    <div class="mb-3">
      <label>Setting Key:</label>
      <input type="text" name="key" required class="form-control" placeholder="e.g. MAINTENANCE_MODE">
    </div>
    <div class="mb-3">
      <label>Setting Value:</label>
      <input type="text" name="value" required class="form-control" placeholder="e.g. true / false">
    </div>
    <button type="submit" class="btn btn-primary">Update Setting</button>
  </form>
</div>