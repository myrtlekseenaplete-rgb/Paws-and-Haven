<div class="container mt-4">
  <h2>System Activity Audit Viewer</h2>
  <table class="table table-bordered mt-3">
    <thead>
      <tr>
        <th>User ID</th>
        <th>Action</th>
        <th>Details</th>
        <th>IP Address</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody>
      <% logs.forEach(log => { %>
        <tr>
          <td><%= log.user_id %></td>
          <td><span class="badge bg-dark"><%= log.action %></span></td>
          <td><%= log.details %></td>
          <td><%= log.ip_address %></td>
          <td><%= new Date(log.timestamp).toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>